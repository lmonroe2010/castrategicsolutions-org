---
// The four-stat strip below the hero. Unit characters wrapped in <span class="u">
// pick up the steel-blue accent color via styles.css.
import { AS_OF } from '../data/figures.js';
---
<section class="data-strip">
  <div class="container">
    <div>
      <div class="fig">1,951</div>
      <div class="cap">People experiencing homelessness in Sonoma County (2026 Point-in-Time Count) — 1,098 of them unsheltered</div>
    </div>
    <div>
      <div class="fig">14,000<span class="u">+</span></div>
      <div class="cap">Low-income Sonoma County renters without access to an affordable home</div>
    </div>
    <div>
      <div class="fig">9 <span class="u">in</span> 10</div>
      <div class="cap">Extremely low-income renters spending 30%+ of income on housing</div>
    </div>
    <div>
      <div class="fig"><span class="u">$</span>84k<span class="u">+</span></div>
      <div class="cap">Annual income needed to afford average Sonoma County rent without being cost-burdened</div>
    </div>
  </div>
  <p class="figures-asof">Figures as of {AS_OF}</p>
</section>
