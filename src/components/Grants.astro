---
// Community Grants (Update Package v3, B6). Copy is used word for word; every
// figure comes from src/data/figures.js, which checks the arithmetic at build.
import { AS_OF, CYCLES, TOTALS_ORDER, TOTAL, usd } from '../data/figures.js';

const byKey = Object.fromEntries(CYCLES.map((c) => [c.key, c]));
const gravenstein = byKey['gravenstein'];
const [fence, furnishings] = gravenstein.grants;
const healthyRoomSeed = byKey['q1-2026'].grants.find((g) => g.org === 'healthy-room');
---
<section class="section paper" id="grants">
  <div class="container">
    <div class="opener grants-intro">
      <div class="eyebrow">Our Grants</div>
      <h2>Community Grants</h2>
      <p class="lead">Strategic Solutions, Inc. commits 50% of all funds raised to community grants in housing, affordability, food security and education across Sonoma County, with priority to the rural and unincorporated communities around Sebastopol: Graton, Occidental, Freestone and Camp Meeker.</p>
      <p class="lead">We look for grants that change an outcome: a home kept open, a bedroom rebuilt, a family housed, rather than the same need returning next quarter. And when another organization already has a strategy that works, we put resources behind it.</p>
      <p class="lead">Since our first grant cycle in early 2026, SSI has awarded {usd(TOTAL.amount)} through {TOTAL.grants} grants benefiting {TOTAL.organizations} organizations.</p>
    </div>

    {/* HOLD (package B1 #3): grant-cycle banner kept exactly as currently live
        until Luke announces the next cycle's dates or takes it down. */}
    <div class="grants-cycle-banner">
      <div>
        <div class="label">Q3 2026 Grant Cycle · Now Open</div>
        <p>Applications for the <strong>Q3 2026</strong> community-grant cycle are now open.</p>
      </div>
      <a class="btn btn-primary" href="mailto:Luke@CaStrategicSolutions.org?subject=Q3%202026%20Grant%20Application">Apply for a Grant</a>
    </div>

    <div class="grants-features">
      <div class="giffen-card">
        <div class="giffen-body">
          <p class="giffen-intro"><strong>Featured: Gravenstein Commons, Sebastopol — {usd(gravenstein.total)}.</strong> Gravenstein Commons is 22 apartments of permanent supportive housing at 845 Gravenstein Highway North in Sebastopol, owned by St. Vincent de Paul: 21 homes for residents and one manager's unit. SSI committed {usd(gravenstein.total)} so the building opens secure and ready to live in.</p>
          <p><strong>Perimeter fence — {usd(fence.amount)}.</strong> SSI funded the perimeter fence project for Gravenstein Commons, giving residents a secure, private home.</p>
          <p><strong>Apartment furnishings — {usd(furnishings.amount)}.</strong> SSI's grant to The Healthy Room Project furnished all 21 resident apartments, so every resident moves into a home rather than an empty room.</p>
        </div>
        <aside class="giffen-meta">
          <div class="giffen-stack-item">
            <div class="micro">SSI commitment</div>
            <div class="val">{usd(gravenstein.total)}</div>
          </div>
          <div class="giffen-stack-item">
            <div class="micro">Perimeter fence</div>
            <div class="val">{usd(fence.amount)}</div>
          </div>
          <div class="giffen-stack-item">
            <div class="micro">Apartment furnishings</div>
            <div class="val">{usd(furnishings.amount)}</div>
          </div>
          <div class="giffen-stack-item">
            <div class="micro">Location</div>
            <div class="val">Sebastopol</div>
          </div>
        </aside>
      </div>

      <div class="giffen-card">
        <div class="giffen-body">
          <p><strong>Key partnership: The Healthy Room Project.</strong> In early 2026, SSI provided the seed funding that opened The Healthy Room Project's first Sonoma County branch, which rebuilds bedrooms in a single day for children ages 5 to 16, starting in unincorporated West County. At Gravenstein Commons, Healthy Room brought that same capability to adults moving out of homelessness: it organized purchasing, delivery and setup for all 21 apartments, and secured discounts and donated goods that stretched every grant dollar further. It is the partnership model SSI's grant program is built on: back an organization with a strategy that works, then put that strategy to work again.</p>
        </div>
        <aside class="giffen-meta">
          <div class="giffen-stack-item">
            <div class="micro">Q1 2026 · Seed funding</div>
            <div class="val">{usd(healthyRoomSeed.amount)}</div>
          </div>
          <div class="giffen-stack-item">
            <div class="micro">Gravenstein Commons · Furnishings</div>
            <div class="val">{usd(furnishings.amount)}</div>
          </div>
        </aside>
      </div>
    </div>

    {CYCLES.map((c) => (
      <Fragment>
        <div class="grants-divider">
          <span>{c.label}</span>
        </div>
        <div class="grants-a">
          <div class="head">
            <div>Amount</div>
            <div>Recipient</div>
            <div>Where</div>
          </div>
          {c.grants.map((g) => (
            <div class="row">
              <div class="amount">{usd(g.amount)}</div>
              <div>
                <h4>{g.name}</h4>
                <p>{g.funded}</p>
              </div>
              <div class="where">{g.where}</div>
            </div>
          ))}
          <div class="foot">
            <div class="amount">{usd(c.total)}</div>
            <div class="lbl">{c.totalsLabel}</div>
            <div class="meta">{c.grants.length} grants</div>
          </div>
        </div>
      </Fragment>
    ))}

    <div class="grants-divider">
      <span>Totals</span>
    </div>
    <div class="grants-a">
      <div class="head">
        <div>Amount</div>
        <div>Cycle</div>
        <div>Grants</div>
      </div>
      {TOTALS_ORDER.map((key) => (
        <div class="row">
          <div class="amount">{usd(byKey[key].total)}</div>
          <div><h4>{byKey[key].totalsLabel}</h4></div>
          <div class="where">{byKey[key].grants.length}</div>
        </div>
      ))}
      <div class="foot">
        <div class="amount">{usd(TOTAL.amount)}</div>
        <div class="lbl">Total — {TOTAL.organizations} organizations</div>
        <div class="meta">{TOTAL.grants} grants</div>
      </div>
    </div>
    <p class="figures-asof">Figures as of {AS_OF}</p>
  </div>
</section>
